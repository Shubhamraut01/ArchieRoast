# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.

# JarvisLabs serverless deployment (OpenAI-compatible endpoint).
# Format: https://serverlessn.jarvislabs.net/openai/<deployment_id>/v1
JARVIS_BASE_URL=

# Your JarvisLabs API key (from your JarvisLabs API settings).
JARVIS_API_KEY=

# Exact model name the deployment serves; it must be vision-capable.
JARVIS_MODEL=

# ---- Temporal (optional): runs each review step as a durable workflow ----
# Set to "true" to route /api/review through Temporal. Requires a Temporal
# server and a running worker (see TEMPORAL.md). Anything else keeps the
# original in-process behaviour.
TEMPORAL_ENABLED=false
# Temporal server address. Default: localhost:7233 (the local dev server).
TEMPORAL_ADDRESS=
# Namespace. Default: default
TEMPORAL_NAMESPACE=
# Task queue the worker polls. Default: archie-roast
TEMPORAL_TASK_QUEUE=
# Temporal Cloud API key. Setting it turns TLS on. Leave empty for local dev.
TEMPORAL_API_KEY=
# Base URL for "View execution history" links.
# Default: http://localhost:8233/namespaces/<namespace>
TEMPORAL_UI_URL=
# Demo only: fail the first N attempts of every step to show automatic retries.
DEMO_FAIL_FIRST_ATTEMPTS=0
