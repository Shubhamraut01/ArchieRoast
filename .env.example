# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.

# JarvisLabs serverless deployment (OpenAI-compatible endpoint).
# Format: https://serverlessn.jarvislabs.net/openai/<deployment_id>/v1
JARVIS_BASE_URL=

# Your JarvisLabs API key (from your JarvisLabs API settings).
JARVIS_API_KEY=

# Exact model name the deployment serves; it must be vision-capable.
JARVIS_MODEL=
